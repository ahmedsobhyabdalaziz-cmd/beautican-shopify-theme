      <div class="swipe-hint" id="swipeHint">
        <span>{%- if request.locale.iso_code == 'ar' -%}اسحب{%- else -%}Swipe{%- endif -%}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var containers = document.querySelectorAll('[data-video-container]');
      containers.forEach(function(container) {
        var video = container.querySelector('[data-doctor-video]');
        var playBtn = container.querySelector('[data-play-btn]');
        if (!video || !playBtn) return;

        playBtn.addEventListener('click', function() {
          video.setAttribute('controls', '');
          video.play();
          playBtn.style.display = 'none';
        });

        video.addEventListener('pause', function() {
          if (video.currentTime < video.duration - 0.5) {
            playBtn.style.display = 'flex';
          }
        });

        video.addEventListener('ended', function() {
          video.removeAttribute('controls');
          playBtn.style.display = 'flex';
        });
      });

      var scroll = document.getElementById('doctorsScroll');
      var dots = document.querySelectorAll('.doctors-dot');
      var hint = document.getElementById('swipeHint');
      if (!scroll || !dots.length) return;

      var cards = scroll.querySelectorAll('.doctor-card-compact');
      var hintDismissed = false;

      function getActiveIndex() {
        var scrollCenter = scroll.scrollLeft + scroll.offsetWidth / 2;
        var closest = 0;
        var minDist = Infinity;
        cards.forEach(function(card, i) {
          var cardCenter = card.offsetLeft - scroll.offsetLeft + card.offsetWidth / 2;
          var dist = Math.abs(scrollCenter - cardCenter);
          if (dist < minDist) { minDist = dist; closest = i; }
        });
        return closest;
      }

      function updateDots(activeIdx) {
        dots.forEach(function(dot, i) {
          dot.classList.toggle('active', i === activeIdx);
        });
      }

      var scrollTimer;
      scroll.addEventListener('scroll', function() {
        if (!hintDismissed && hint) { hint.classList.add('hidden'); hintDismissed = true; }
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(function() { updateDots(getActiveIndex()); }, 80);
      }, { passive: true });

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var idx = parseInt(dot.getAttribute('data-dot-index'), 10);
          if (cards[idx]) {
            var cardLeft = cards[idx].offsetLeft - scroll.offsetLeft;
            var offset = cardLeft - (scroll.offsetWidth - cards[idx].offsetWidth) / 2;
            scroll.scrollTo({ left: offset, behavior: 'smooth' });
          }
        });
      });

      if (hint && window.innerWidth < 768) {
        setTimeout(function() { if (!hintDismissed) { hint.classList.add('hidden'); hintDismissed = true; } }, 4000);
      }
    })();
  </script>
</section>

