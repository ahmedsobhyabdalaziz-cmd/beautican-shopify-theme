<!-- ==================== HEADER ==================== -->
{% render 'header' %}

<!-- ==================== CART DRAWER ==================== -->
<div data-cart-overlay class="sheet-overlay hidden"></div>
<div data-cart-drawer class="sheet-content sheet-right">
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between p-6 border-b border-border">
      <h2 class="text-xl font-display font-semibold">{{ 'cart.title' | t }}</h2>
      <button data-cart-close class="text-muted-foreground hover:text-foreground transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div data-cart-content class="flex-1 flex flex-col overflow-hidden">
      <div class="flex flex-col items-center justify-center py-16 px-6 text-center">
        <svg class="w-16 h-16 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <p class="text-muted-foreground">{{ 'cart.empty' | t }}</p>
      </div>
    </div>
  </div>
</div>

<!-- ==================== DYNAMIC PRICE CALCULATIONS ==================== -->
{% unless product %}
  {% assign product = all_products['beautican'] %}
{% endunless %}
{% assign first_variant_price = product.variants.first.price | divided_by: 100 %}
{% assign lowest_daily = 999.0 %}
{% for v in product.variants limit: 3 %}
  {% assign s = 30 %}
  {% if forloop.index0 == 1 %}{% assign s = 60 %}{% endif %}
  {% if forloop.index0 == 2 %}{% assign s = 90 %}{% endif %}
  {% assign price_in_sar = v.price | times: 1.0 | divided_by: 100.0 %}
  {% assign daily = price_in_sar | divided_by: s %}
  {% if daily < lowest_daily %}{% assign lowest_daily = daily %}{% endif %}
{% endfor %}
{% assign lowest_daily = lowest_daily | round %}

<!-- ==================== PRODUCT HERO SECTION ==================== -->
{% assign hero_price = product.selected_or_first_available_variant.price | divided_by: 100 %}
{% assign hero_compare = product.selected_or_first_available_variant.compare_at_price %}
<style>
  .product-thumb { width: 56px; height: 56px; border-radius: 6px; overflow: hidden; border: 2px solid hsl(var(--border)); cursor: pointer; transition: border-color 0.2s; flex-shrink: 0; }
  .product-thumb.active, .product-thumb:hover { border-color: hsl(var(--accent)); }
  .product-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .benefit-check { display: flex; align-items: flex-start; gap: 10px; padding: 6px 0; }
  .benefit-check svg { width: 20px; height: 20px; flex-shrink: 0; color: hsl(var(--accent)); margin-top: 1px; }
  .guarantee-bar { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 8px; border: 1px solid hsl(var(--border)); background: hsl(var(--card)); }
  .guarantee-bar p { word-break: break-word; overflow-wrap: anywhere; }
  .guarantee-icon { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: hsl(142 71% 45% / 0.12); }
  .guarantee-icon svg { width: 18px; height: 18px; color: hsl(142 71% 45%); }
  .product-sticky-atc { position: fixed; bottom: 0; left: 0; right: 0; z-index: 40; border-top: 1px solid hsl(var(--border)); padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: hsl(var(--background) / 0.97); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  @media (min-width: 768px) { .product-sticky-atc { display: none; } }
</style>

<!-- ===== MOBILE LAYOUT (visible < md) ===== -->
<section class="md:hidden bg-background">
  <div class="px-5 py-6">

    <!-- 1) Title + Stars -->
    <h1 class="text-xl font-display font-bold text-foreground leading-tight mb-2">{{ product.title }}</h1>
    <div class="flex items-center gap-2 mb-4">
      <div class="flex items-center gap-0.5">
        {% for i in (1..5) %}
          <svg class="w-3.5 h-3.5 text-yellow-400 fill-yellow-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        {% endfor %}
      </div>
      <span class="text-sm font-semibold text-foreground">4.6</span>
      <span class="text-sm text-muted-foreground">(128 {%- if request.locale.iso_code == 'ar' %} تقييم{%- else %} reviews{%- endif -%})</span>
    </div>

    <!-- Price row -->
    <div class="flex items-baseline gap-3 mb-1">
      <span class="text-2xl font-bold text-accent">{{ hero_price }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon sar-icon-lg" /></span>
      {% if hero_compare and hero_compare > product.selected_or_first_available_variant.price %}
        {% assign hero_compare_num = hero_compare | divided_by: 100 %}
        <span class="text-base text-muted-foreground line-through">{{ hero_compare_num }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon sar-icon-sm" /></span>
      {% endif %}
    </div>
    {% if product.vendor != blank %}
      <p class="text-sm text-muted-foreground mb-4">{%- if request.locale.iso_code == 'ar' -%}البائع: <strong class="text-foreground">{{ product.vendor }}</strong>{%- else -%}Vendor: <strong class="text-foreground">{{ product.vendor }}</strong>{%- endif -%}</p>
    {% endif %}

    <!-- 2) Product Image (compact) -->
    <div class="rounded-lg overflow-hidden border border-border mb-4" style="aspect-ratio: 4/3;">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" class="w-full h-full object-cover" id="hero-product-image-m" />
      {% endif %}
    </div>
    {% if product.images.size > 1 %}
      <div class="flex gap-2 overflow-x-auto pb-2 mb-4">
        {% for image in product.images limit: 6 %}
          <button class="product-thumb{% if forloop.first %} active{% endif %}" onclick="var img=document.getElementById('hero-product-image-m');if(img){img.src='{{ image | image_url: width: 800 }}';} document.querySelectorAll('.md\\:hidden .product-thumb').forEach(function(t){t.classList.remove('active')});this.classList.add('active');">
            <img src="{{ image | image_url: width: 120 }}" alt="" loading="lazy" />
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <!-- 3) Guarantee Bar -->
    <div class="guarantee-bar mb-4">
      <div class="guarantee-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-bold text-foreground">{%- if request.locale.iso_code == 'ar' -%}منتج أصلي 100%{%- else -%}Authenticity Guaranteed{%- endif -%}</p>
        <p class="text-xs text-muted-foreground leading-snug">{%- if request.locale.iso_code == 'ar' -%}مُصنّع بإيطاليا بمعايير أوروبية ومعتمد من كبرى شركات الأدوية بالمملكة{%- else -%}Made in Italy under European standards{%- endif -%}</p>
      </div>
    </div>

    <!-- 4) Benefits -->
    <div class="rounded-lg border border-border bg-card p-4 mb-4">
      <div class="benefit-check">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
        <span class="text-sm text-foreground">{{ 'beautican.hero.benefit_1_title' | t }} — {{ 'beautican.hero.benefit_1_desc' | t }}</span>
      </div>
      <div class="benefit-check">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
        <span class="text-sm text-foreground">{{ 'beautican.hero.benefit_2_title' | t }} — {{ 'beautican.hero.benefit_2_desc' | t }}</span>
      </div>
      <div class="benefit-check">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
        <span class="text-sm text-foreground">{{ 'beautican.hero.benefit_3_title' | t }} — {{ 'beautican.hero.benefit_3_desc' | t }}</span>
      </div>
      <div class="benefit-check">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
        <span class="text-sm text-foreground">{{ 'beautican.hero.benefit_4_title' | t }} — {{ 'beautican.hero.benefit_4_desc' | t }}</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== DESKTOP LAYOUT (visible >= md) ===== -->
<section class="hidden md:block bg-background">
  <div class="max-w-6xl mx-auto px-6 lg:px-16 py-14">
    <div class="grid md:grid-cols-2 gap-10 lg:gap-14 items-start">

      <!-- Left: Product Images -->
      <div class="space-y-4 animate-on-scroll">
        <div class="aspect-square bg-card rounded-lg overflow-hidden border border-border">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" class="w-full h-full object-cover" id="hero-product-image-d" />
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="flex gap-3 overflow-x-auto pb-1">
            {% for image in product.images limit: 6 %}
              <button class="product-thumb{% if forloop.first %} active{% endif %}" onclick="var img=document.getElementById('hero-product-image-d');if(img){img.src='{{ image | image_url: width: 800 }}';} document.querySelectorAll('.md\\:block .product-thumb').forEach(function(t){t.classList.remove('active')});this.classList.add('active');">
                <img src="{{ image | image_url: width: 120 }}" alt="" loading="lazy" />
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Right: Product Info -->
      <div class="flex flex-col animate-on-scroll">
        <h1 class="text-3xl font-display font-bold text-foreground leading-tight mb-3">{{ product.title }}</h1>
        <div class="flex items-center gap-2 mb-4">
          <div class="flex items-center gap-0.5">
            {% for i in (1..5) %}
              <svg class="w-4 h-4 text-yellow-400 fill-yellow-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {% endfor %}
          </div>
          <span class="text-sm font-semibold text-foreground">4.6</span>
          <span class="text-sm text-muted-foreground">(128 {%- if request.locale.iso_code == 'ar' %} تقييم{%- else %} reviews{%- endif -%})</span>
        </div>
        <div class="flex items-baseline gap-3 mb-2">
          <span class="text-3xl font-bold text-accent">{{ hero_price }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon sar-icon-lg" /></span>
          {% if hero_compare and hero_compare > product.selected_or_first_available_variant.price %}
            {% assign hero_compare_num = hero_compare | divided_by: 100 %}
            <span class="text-lg text-muted-foreground line-through">{{ hero_compare_num }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon sar-icon-sm" /></span>
          {% endif %}
        </div>
        {% if product.vendor != blank %}
          <p class="text-sm text-muted-foreground mb-5">{%- if request.locale.iso_code == 'ar' -%}البائع: <strong class="text-foreground">{{ product.vendor }}</strong>{%- else -%}Vendor: <strong class="text-foreground">{{ product.vendor }}</strong>{%- endif -%}</p>
        {% endif %}
        <div class="rounded-lg border border-border bg-card p-5 mb-5">
          <div class="benefit-check"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg><span class="text-sm text-foreground">{{ 'beautican.hero.benefit_1_title' | t }} — {{ 'beautican.hero.benefit_1_desc' | t }}</span></div>
          <div class="benefit-check"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg><span class="text-sm text-foreground">{{ 'beautican.hero.benefit_2_title' | t }} — {{ 'beautican.hero.benefit_2_desc' | t }}</span></div>
          <div class="benefit-check"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg><span class="text-sm text-foreground">{{ 'beautican.hero.benefit_3_title' | t }} — {{ 'beautican.hero.benefit_3_desc' | t }}</span></div>
          <div class="benefit-check"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg><span class="text-sm text-foreground">{{ 'beautican.hero.benefit_4_title' | t }} — {{ 'beautican.hero.benefit_4_desc' | t }}</span></div>
        </div>
        <div class="guarantee-bar mb-6">
          <div class="guarantee-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold text-foreground">{%- if request.locale.iso_code == 'ar' -%}منتج أصلي 100%{%- else -%}Authenticity Guaranteed{%- endif -%}</p>
            <p class="text-xs text-muted-foreground">{{ 'beautican.hero.certification' | t }}</p>
          </div>
          <svg class="w-5 h-5 text-muted-foreground flex-shrink-0 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
        </div>
        <button data-add-to-cart data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-quantity="1" class="w-full flex items-center justify-center gap-3 px-8 py-4 bg-accent text-accent-foreground font-body font-bold text-base rounded-lg shadow-md hover:brightness-110 hover:shadow-lg active:scale-[0.98] transition-all" style="box-shadow: 0 4px 14px hsl(var(--accent) / 0.3);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121 0 2.002-.881 2.002-2V5.25H5.625M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
          <span>{{ 'product.add_to_cart' | t }}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Sticky mobile bottom bar -->
<div class="product-sticky-atc">
  <span class="text-lg font-bold text-foreground">{{ hero_price }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon" /></span>
  <button data-add-to-cart data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-quantity="1" class="flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-accent text-accent-foreground font-body font-bold text-sm rounded-lg hover:brightness-110 active:scale-[0.98] transition-all" style="box-shadow: 0 4px 14px hsl(var(--accent) / 0.3);">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121 0 2.002-.881 2.002-2V5.25H5.625M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
    <span>{{ 'product.add_to_cart' | t }}</span>
  </button>
</div>

<!-- ==================== WATCH DOCTORS SECTION ==================== -->
<style>
  .doctors-carousel-wrap { position: relative; }
  .doctors-scroll { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 0 8px 4px; scroll-behavior: smooth; }
  .doctors-scroll::-webkit-scrollbar { display: none; }
  .doctor-card-compact { scroll-snap-align: center; flex: 0 0 65vw; max-width: 220px; transition: transform 0.3s ease, opacity 0.3s ease; }

  .doctors-fade-left,
  .doctors-fade-right { display: block; position: absolute; top: 0; bottom: 30px; width: 40px; pointer-events: none; z-index: 2; }
  .doctors-fade-left { left: 0; background: linear-gradient(to right, hsl(var(--card)), transparent); }
  .doctors-fade-right { right: 0; background: linear-gradient(to left, hsl(var(--card)), transparent); }

  .doctors-dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
  .doctors-dot { width: 8px; height: 8px; border-radius: 50%; background: hsl(var(--muted-foreground) / 0.3); border: none; padding: 0; cursor: pointer; transition: all 0.3s ease; }
  .doctors-dot.active { background: hsl(var(--accent)); width: 24px; border-radius: 4px; }

  .swipe-hint { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 12px; color: hsl(var(--muted-foreground)); font-size: 0.75rem; opacity: 1; transition: opacity 0.4s ease; }
  .swipe-hint.hidden { opacity: 0; pointer-events: none; }
  .swipe-hint svg { animation: swipeNudge 1.5s ease-in-out infinite; }
  @keyframes swipeNudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(6px); } }

  @media (min-width: 768px) {
    .doctors-scroll { justify-content: center; flex-wrap: wrap; overflow-x: visible; scroll-snap-type: none; padding: 0; }
    .doctor-card-compact { flex: 0 0 220px; scroll-snap-align: unset; }
    .doctors-fade-left, .doctors-fade-right, .doctors-dots, .swipe-hint { display: none !important; }
  }
</style>
<section class="py-12 md:py-16" style="background-color: hsl(var(--card));">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="text-center mb-8">
      <div class="w-12 h-12 mx-auto mb-4 rounded-full flex items-center justify-center animate-on-scroll" style="background: hsl(var(--accent) / 0.1);">
        <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
