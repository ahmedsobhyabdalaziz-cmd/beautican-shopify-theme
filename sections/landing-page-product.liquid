<!-- ==================== PRICING SECTION ==================== -->
<section id="pricing" class="py-16 md:py-24">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <p class="text-accent font-body text-sm tracking-normal mb-4 animate-on-scroll">{{ 'beautican.pricing.tagline' | t }}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display leading-tight mb-6 animate-on-scroll">
        <span>{{ 'beautican.pricing.title_before' | t }} {{ lowest_daily }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon" /> {{ 'beautican.pricing.title_after' | t }}</span>
        <br />
        <em class="text-accent not-italic">{{ 'beautican.pricing.title_accent' | t }}</em>
      </h2>
      <p class="text-muted-foreground text-lg leading-snug animate-on-scroll">{{ 'beautican.pricing.description' | t }}</p>
      <p class="text-accent text-sm font-body font-medium mt-4 tracking-normal animate-on-scroll">{{ 'beautican.pricing.social_proof' | t }}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto items-stretch">
      {% assign tier_names = "Starter,Most Popular,Transformation" | split: "," %}
      {% assign tier_badges = ",Best Value,Biggest Savings" | split: "," %}

      {% for variant in product.variants limit: 3 %}
        {% assign tier_index = forloop.index0 %}
        {% if tier_index == 1 %}
          {% assign is_featured = true %}
        {% else %}
          {% assign is_featured = false %}
        {% endif %}
        {% assign variant_price_num = variant.price | divided_by: 100 %}
        {% assign sachets = 30 %}
        {% if tier_index == 1 %}{% assign sachets = 60 %}{% endif %}
        {% if tier_index == 2 %}{% assign sachets = 90 %}{% endif %}
        {% assign per_sachet = variant.price | divided_by: sachets | divided_by: 100.0 %}

        <div class="relative rounded-sm border-2 p-8 flex flex-col transition-all animate-on-scroll {% if is_featured %}border-accent scale-[1.03] md:scale-105{% else %}border-border bg-background hover:shadow-md{% endif %}" style="animation-delay: {{ tier_index | times: 0.1 }}s;{% if is_featured %} background: hsl(var(--accent) / 0.05); box-shadow: 0 20px 25px -5px hsl(var(--accent) / 0.2), 0 8px 10px -6px hsl(var(--accent) / 0.2), 0 0 0 1px hsl(var(--accent) / 0.3);{% endif %}">

          {% if tier_badges[tier_index] != "" %}
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center gap-1.5 px-4 py-1 bg-accent text-accent-foreground text-xs font-body font-semibold tracking-normal rounded-full">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span>{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_badge' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_badge' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_badge' | t }}{% endif %}</span>
              </span>
            </div>
          {% endif %}

          <div class="text-center mb-6">
            <p class="text-sm font-body tracking-normal text-muted-foreground mb-1">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_name' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_name' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_name' | t }}{% endif %}</p>
            <p class="font-display text-lg">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_subtitle' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_subtitle' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_subtitle' | t }}{% endif %}</p>
            <p class="text-xs text-muted-foreground mt-1">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_sachets' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_sachets' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_sachets' | t }}{% endif %}</p>
            {% if tier_index > 0 %}
              <p class="text-xs font-body italic mt-2" style="color: hsl(var(--accent) / 0.8);">{% if tier_index == 1 %}{{ 'beautican.pricing.tier_1_recommend' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_recommend' | t }}{% endif %}</p>
            {% endif %}
          </div>

          <div class="text-center mb-6">
            <p class="text-4xl font-display">
              {{ variant_price_num }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon sar-icon-lg" />
            </p>
            <p class="text-sm text-muted-foreground mt-1">
              {{ per_sachet | round: 2 }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon sar-icon-sm" /> <span>{{ 'beautican.pricing.per_sachet' | t }}</span>
            </p>
            {% if tier_index > 0 %}
              {% assign base_price_cents = product.variants.first.price %}
              {% assign base_total_cents = base_price_cents | times: sachets | divided_by: 30 %}
              {% assign savings = base_total_cents | minus: variant.price | times: 100 | divided_by: base_total_cents %}
              <p class="text-sm text-accent font-medium mt-2">
                <span>{{ 'beautican.pricing.save' | t }}</span> {{ savings }}%
              </p>
            {% endif %}
            <p class="inline-flex items-center gap-1.5 mt-3 px-3 py-1 rounded-full text-xs font-bold" style="background: hsl(var(--accent) / 0.1); color: hsl(var(--accent));">{{ 'beautican.pricing.tax_shipping' | t }}</p>
          </div>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2.5 text-sm font-body">
              <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-muted-foreground">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_inclusion_0' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_inclusion_0' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_inclusion_0' | t }}{% endif %}</span>
            </li>
            <li class="flex items-start gap-2.5 text-sm font-body">
              <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-muted-foreground">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_inclusion_1' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_inclusion_1' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_inclusion_1' | t }}{% endif %}</span>
            </li>
            <li class="flex items-start gap-2.5 text-sm font-body">
              <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-muted-foreground">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_inclusion_2' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_inclusion_2' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_inclusion_2' | t }}{% endif %}</span>
            </li>
            <li class="flex items-start gap-2.5 text-sm font-body">
              <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-muted-foreground">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_inclusion_3' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_inclusion_3' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_inclusion_3' | t }}{% endif %}</span>
            </li>
            <li class="flex items-start gap-2.5 text-sm font-body">
              <svg class="w-4 h-4 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-muted-foreground">{% if tier_index == 0 %}{{ 'beautican.pricing.tier_0_inclusion_4' | t }}{% elsif tier_index == 1 %}{{ 'beautican.pricing.tier_1_inclusion_4' | t }}{% elsif tier_index == 2 %}{{ 'beautican.pricing.tier_2_inclusion_4' | t }}{% endif %}</span>
            </li>
          </ul>

          <button
            data-add-to-cart
            data-variant-id="{{ variant.id }}"
            data-quantity="1"
            class="w-full font-body font-bold text-sm tracking-normal rounded-sm transition-all disabled:opacity-50 flex items-center justify-center gap-3 hover:brightness-110 hover:shadow-lg active:scale-[0.98] {% if is_featured %}bg-accent text-accent-foreground{% else %}bg-primary text-primary-foreground{% endif %}"
            style="min-height: 56px; padding: 16px 24px; {% if is_featured %}box-shadow: 0 4px 14px hsl(var(--accent) / 0.3);{% endif %}"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <span>{% if is_featured %}{{ 'beautican.pricing.cta_featured' | t }}{% else %}{{ 'beautican.pricing.cta' | t }}{% endif %}</span>
          </button>
        </div>
      {% endfor %}
    </div>

    <p class="text-center text-sm text-muted-foreground mt-10 animate-on-scroll">{{ 'beautican.pricing.footer_text' | t }}</p>
  </div>

</section>

<!-- ==================== CTA SECTION ==================== -->
<section class="py-16 md:py-24">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-accent font-body text-sm tracking-normal mb-4 animate-on-scroll">{{ 'beautican.cta_section.tagline' | t }}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display leading-tight mb-6 animate-on-scroll">
        <span>{{ 'beautican.cta_section.title' | t }}</span>
        <br />
        <em class="text-accent not-italic">{{ 'beautican.cta_section.title_accent' | t }}</em>
      </h2>
      <p class="text-muted-foreground text-lg leading-snug mb-10 animate-on-scroll">{{ 'beautican.cta_section.description' | t }}</p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center animate-on-scroll"
        style="animation-delay: 0.3s"
      >
        <a
          href="#pricing"
          class="inline-flex items-center justify-center px-12 py-5 bg-accent text-accent-foreground font-body font-bold text-sm tracking-normal rounded-sm hover:brightness-110 hover:shadow-lg active:scale-[0.97] transition-all"
          style="box-shadow: 0 4px 14px hsl(var(--accent) / 0.3); min-height: 56px;"
        >{{ 'beautican.cta_section.button' | t }}</a>
      </div>

      <p
        class="mt-8 text-sm text-muted-foreground animate-on-scroll"
        style="animation-delay: 0.45s"
      >{{ 'beautican.cta_section.footer_text' | t }}</p>
    </div>
  </div>
</section>

<!-- ==================== FOOTER ==================== -->
<footer class="py-12 border-t border-border">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-4">
        <img src="{{ 'tapharma-logo.png' | asset_url }}" alt="تقنية الدواء" class="h-8 object-contain" />
        <div>
          <p class="font-display text-lg tracking-normal">{{ 'footer.brand' | t }}</p>
          <p class="text-sm text-muted-foreground mt-0.5">{{ 'footer.tagline' | t }}</p>
        </div>
      </div>
      <p class="text-sm text-muted-foreground">
        © {{ 'now' | date: '%Y' }} <span>{{ 'footer.brand' | t }}</span>. <span>{{ 'footer.rights' | t }}</span>
      </p>
    </div>
  </div>
</footer>

<script>
document.addEventListener('DOMContentLoaded', function() {
  function applyArabicFonts() {
    if (document.documentElement.lang !== 'ar') return;
    document.querySelectorAll('h1,h2,h3,h4,h5,h6,.font-display').forEach(function(el) {
      el.style.setProperty('font-family', '"Kufam", "Tajawal", sans-serif', 'important');
      el.style.setProperty('font-weight', '700', 'important');
      el.style.setProperty('letter-spacing', '0', 'important');
      el.style.setProperty('line-height', '1.4', 'important');
      el.querySelectorAll('*').forEach(function(child) {
        child.style.setProperty('font-family', '"Kufam", "Tajawal", sans-serif', 'important');
        child.style.setProperty('font-weight', '700', 'important');
        child.style.setProperty('letter-spacing', '0', 'important');
      });
    });
    document.querySelectorAll('p, a, button, span, input, label, li, td, th, div').forEach(function(el) {
      if (el.closest('h1') || el.closest('h2') || el.closest('h3') || el.closest('h4') || el.closest('h5') || el.closest('h6')) return;
      el.style.setProperty('letter-spacing', '0', 'important');
    });
  }
  applyArabicFonts();
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.attributeName === 'lang') applyArabicFonts();
    });
  });
  observer.observe(document.documentElement, { attributes: true });
});
</script>

