<!-- ==================== HEADER ==================== -->
{% render 'header' %}

<!-- ==================== CART DRAWER ==================== -->
<div data-cart-overlay class="sheet-overlay hidden"></div>
<div data-cart-drawer class="sheet-content sheet-right">
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between p-6 border-b border-border">
      <h2 class="text-xl font-display font-semibold">{{ 'cart.title' | t }}</h2>
      <button data-cart-close class="text-muted-foreground hover:text-foreground transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div data-cart-content class="flex-1 flex flex-col overflow-hidden">
      <div class="flex flex-col items-center justify-center py-16 px-6 text-center">
        <svg class="w-16 h-16 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <p class="text-muted-foreground">{{ 'cart.empty' | t }}</p>
      </div>
    </div>
  </div>
</div>

<!-- ==================== DYNAMIC PRICE CALCULATIONS ==================== -->
{% unless product %}
  {% assign product = all_products['beautican'] %}
{% endunless %}
{% assign first_variant_price = product.variants.first.price | divided_by: 100 %}
{% assign lowest_daily = 999.0 %}
{% for v in product.variants limit: 3 %}
  {% assign s = 30 %}
  {% if forloop.index0 == 1 %}{% assign s = 60 %}{% endif %}
  {% if forloop.index0 == 2 %}{% assign s = 90 %}{% endif %}
  {% assign price_in_sar = v.price | times: 1.0 | divided_by: 100.0 %}
  {% assign daily = price_in_sar | divided_by: s %}
  {% if daily < lowest_daily %}{% assign lowest_daily = daily %}{% endif %}
{% endfor %}
{% assign lowest_daily = lowest_daily | round %}

<!-- ==================== HERO SECTION ==================== -->
<section class="relative overflow-hidden bg-background">
  <div class="container mx-auto px-6 lg:px-16 py-20 md:py-28">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-8 items-center">

      <!-- Left: Headline & CTAs -->
      <div class="order-1 md:order-1">
        <p class="text-sm md:text-base font-bold text-foreground leading-relaxed mb-6 animate-on-scroll">{{ 'beautican.hero.tagline' | t }}</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-display tracking-normal leading-tight mb-6 text-foreground animate-on-scroll">
          <span>{{ 'beautican.hero.title_start' | t }}</span><br />
          <em class="text-accent not-italic">{{ 'beautican.hero.title_accent' | t }}</em>
        </h1>
        <p class="text-lg md:text-xl text-foreground font-medium leading-snug mb-8 max-w-lg animate-on-scroll">{{ 'beautican.hero.description' | t }}</p>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-muted/40 border border-border/50 mb-8 animate-on-scroll">
          <span class="text-xl">🇮🇹</span>
          <span class="text-sm font-medium text-foreground">{{ 'beautican.hero.certification' | t }}</span>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 animate-on-scroll">
          <a href="#pricing" class="inline-flex items-center justify-center px-10 py-5 bg-accent text-accent-foreground font-body font-bold text-sm tracking-normal rounded-sm shadow-md hover:opacity-90 transition-all">{{ 'beautican.hero.cta' | t: price: first_variant_price }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon" /></a>
          <a href="#solution" class="inline-flex items-center justify-center px-10 py-5 border-2 bg-foreground text-background font-body font-semibold text-sm tracking-normal rounded-sm hover:bg-transparent hover:text-foreground transition-all" style="border-color: hsl(var(--foreground) / 0.8);">{{ 'beautican.hero.cta_secondary' | t }}</a>
        </div>
      </div>

      <!-- Right: VSL Video -->
      <div class="order-2 md:order-2 flex items-center justify-center">
        <div class="relative w-full max-w-lg mx-auto animate-on-scroll" data-hero-vsl-container>
          <div class="relative rounded-lg overflow-hidden shadow-2xl border-2 border-border bg-card">
            <div class="relative aspect-square">
              <video
                class="w-full h-full object-cover"
                playsinline
                preload="metadata"
                data-hero-vsl-video
              >
                <source src="https://cdn.shopify.com/videos/c/o/v/6c19c5209624401da37c3ef5cccf4bda.mp4" type="video/mp4" />
              </video>
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent pointer-events-none"></div>
              <button class="hero-vsl-play-btn absolute inset-0 flex items-center justify-center cursor-pointer bg-black/20 hover:bg-black/30 transition-all group" data-hero-vsl-play-btn>
                <div class="w-24 h-24 rounded-full bg-accent flex items-center justify-center shadow-2xl transform group-hover:scale-110 transition-transform">
                  <svg class="w-12 h-12 text-accent-foreground ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ==================== WATCH DOCTORS SECTION ==================== -->
<section class="py-16 md:py-24" style="background-color: hsl(var(--card));">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-4">
          <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
          </svg>
          <p class="text-accent font-body text-sm tracking-normal animate-on-scroll">{{ 'beautican.credibility.doctor_tagline_small' | t }}</p>
        </div>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display leading-tight mb-4 animate-on-scroll">{{ 'beautican.credibility.doctor_tagline' | t }}</h2>
        <p class="text-muted-foreground text-base max-w-2xl mx-auto animate-on-scroll">{{ 'beautican.credibility.doctor_description' | t }}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {%- for block in section.blocks -%}
          {%- if block.type == 'doctor_video' and block.settings.video_url != blank -%}
            {%- assign current_lang = request.locale.iso_code -%}
            {%- if current_lang == 'ar' and block.settings.name_ar != blank -%}
              {%- assign doctor_name = block.settings.name_ar -%}
              {%- assign doctor_title = block.settings.title_ar -%}
            {%- else -%}
              {%- assign doctor_name = block.settings.name_en -%}
              {%- assign doctor_title = block.settings.title_en -%}
            {%- endif -%}

            <div class="doctor-video-card group relative rounded-lg overflow-hidden shadow-lg border-2 border-border bg-primary animate-on-scroll hover:shadow-2xl transition-all duration-300" style="animation-delay: {{ forloop.index0 | times: 0.1 }}s" data-video-container {{ block.shopify_attributes }}>
              <div class="relative aspect-square">
                <video
                  class="w-full h-full object-cover"
                  playsinline
                  preload="metadata"
                  data-doctor-video
                >
                  <source src="{{ block.settings.video_url }}" type="video/mp4" />
                </video>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>
                <button class="doctor-play-btn absolute inset-0 flex items-center justify-center cursor-pointer bg-black/30 hover:bg-black/40 transition-all" data-play-btn>
                  <div class="w-20 h-20 rounded-full bg-accent flex items-center justify-center shadow-2xl transform group-hover:scale-110 transition-transform">
                    <svg class="w-10 h-10 text-accent-foreground ml-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </button>
              </div>
              <div class="absolute bottom-0 left-0 right-0 p-6 text-white z-10">
                <h3 class="font-display text-xl font-bold mb-1">{{ doctor_name }}</h3>
                <p class="text-sm opacity-90 font-body">{{ doctor_title }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <script>
      (function() {
        var containers = document.querySelectorAll('[data-video-container]');
        containers.forEach(function(container) {
          var video = container.querySelector('[data-doctor-video]');
          var playBtn = container.querySelector('[data-play-btn]');
          if (!video || !playBtn) return;

          playBtn.addEventListener('click', function() {
            video.setAttribute('controls', '');
            video.play();
            playBtn.style.display = 'none';
          });

          video.addEventListener('pause', function() {
            if (video.currentTime < video.duration - 0.5) {
              playBtn.style.display = 'flex';
            }
          });

          video.addEventListener('ended', function() {
            video.removeAttribute('controls');
            playBtn.style.display = 'flex';
          });
        });
      })();
    </script>
  </div>
</section>

