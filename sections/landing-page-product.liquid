      <div class="doctors-dots" id="doctorsDots">
        {%- assign vc = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'doctor_video' and block.settings.video_url != blank -%}
            <button class="doctors-dot{% if vc == 0 %} active{% endif %}" data-dot-index="{{ vc }}" aria-label="Slide {{ vc | plus: 1 }}"></button>
            {%- assign vc = vc | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
