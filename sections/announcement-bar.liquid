{%- if section.settings.enable -%}
  {%- assign has_announcements = false -%}
  {%- assign current_lang = request.locale.iso_code -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.text != blank or block.settings.text_ar != blank -%}
      {%- assign has_announcements = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_announcements -%}
    <div
      id="announcement-bar"
      class="announcement-bar"
      style="
        background: {{ section.settings.bg_color }};
        color: {{ section.settings.text_color }};
      "
      role="region"
      aria-label="Announcements"
    >
      <div class="announcement-bar__inner">
        {%- if section.blocks.size > 1 -%}
          <div class="announcement-bar__slider" data-announcement-slider>
            {%- for block in section.blocks -%}
              {%- if current_lang == 'ar' and block.settings.text_ar != blank -%}
                {%- assign display_text = block.settings.text_ar -%}
              {%- else -%}
                {%- assign display_text = block.settings.text -%}
              {%- endif -%}
              {%- if display_text != blank -%}
                <div
                  class="announcement-bar__slide {% if forloop.first %}announcement-bar__slide--active{% endif %}"
                  data-announcement-slide
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" class="announcement-bar__link" style="color: {{ section.settings.text_color }};">
                      {{ display_text }}
                    </a>
                  {%- else -%}
                    <span>{{ display_text }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if current_lang == 'ar' and block.settings.text_ar != blank -%}
              {%- assign display_text = block.settings.text_ar -%}
            {%- else -%}
              {%- assign display_text = block.settings.text -%}
            {%- endif -%}
            {%- if display_text != blank -%}
              <div class="announcement-bar__single" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="announcement-bar__link" style="color: {{ section.settings.text_color }};">
                    {{ display_text }}
                  </a>
                {%- else -%}
                  <span>{{ display_text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.dismissible -%}
          <button
            class="announcement-bar__close"
            data-announcement-close
            aria-label="Dismiss announcement"
            style="color: {{ section.settings.text_color }};"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        {%- endif -%}
      </div>
    </div>

    <style>
      .announcement-bar-section {
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .announcement-bar {
        width: 100%;
        overflow: hidden;
        font-family: "Tajawal", "DM Sans", system-ui, sans-serif;
        font-size: {{ section.settings.font_size }}px;
        font-weight: 600;
        letter-spacing: 0.01em;
        line-height: 1.3;
      }
      .announcement-bar__inner {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 40px;
        min-height: 40px;
        position: relative;
      }
      .announcement-bar__slider {
        position: relative;
        width: 100%;
        text-align: center;
      }
      .announcement-bar__slide {
        display: none;
        animation: announceFadeIn 0.5s ease;
      }
      .announcement-bar__slide--active {
        display: block;
      }
      .announcement-bar__single {
        text-align: center;
        width: 100%;
      }
      .announcement-bar__link {
        text-decoration: none;
        transition: opacity 0.2s;
      }
      .announcement-bar__link:hover {
        opacity: 0.8;
        text-decoration: underline;
      }
      .announcement-bar__close {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        opacity: 0.7;
        transition: opacity 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      [dir="rtl"] .announcement-bar__close {
        right: auto;
        left: 12px;
      }
      .announcement-bar__close:hover {
        opacity: 1;
      }
      @keyframes announceFadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>

    <script>
      (function() {
        var bar = document.getElementById('announcement-bar');
        if (!bar) return;

        var dismissed = sessionStorage.getItem('announcement-dismissed');
        if (dismissed === 'true') {
          bar.style.display = 'none';
          return;
        }

        var closeBtn = bar.querySelector('[data-announcement-close]');
        if (closeBtn) {
          closeBtn.addEventListener('click', function() {
            bar.style.display = 'none';
            sessionStorage.setItem('announcement-dismissed', 'true');
          });
        }

        var slides = bar.querySelectorAll('[data-announcement-slide]');
        if (slides.length > 1) {
          var current = 0;
          var interval = {{ section.settings.rotation_speed }}000;
          setInterval(function() {
            slides[current].classList.remove('announcement-bar__slide--active');
            current = (current + 1) % slides.length;
            slides[current].classList.add('announcement-bar__slide--active');
          }, interval);
        }
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a4a5a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow customers to dismiss",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed (seconds)",
      "info": "How long each announcement shows before switching to the next",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text (English)",
          "default": "Free shipping on orders over 200 SAR"
        },
        {
          "type": "text",
          "id": "text_ar",
          "label": "Text (Arabic)",
          "default": "شحن مجاني للطلبات فوق 200 ريال"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping on orders over 200 SAR",
            "text_ar": "شحن مجاني للطلبات فوق 200 ريال"
          }
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}
