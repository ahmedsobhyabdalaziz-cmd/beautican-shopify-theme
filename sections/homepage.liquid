<section id="products" class="py-16 md:py-24">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto text-center mb-14">
      <p class="text-accent font-body text-sm tracking-[0.3em] uppercase mb-4 animate-on-scroll" data-i18n="products.tagline">Our Products</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display tracking-tight animate-on-scroll">
        <span data-i18n="products.title">Explore Our</span><br />
        <em class="text-accent not-italic" data-i18n="products.titleAccent">Product Range</em>
      </h2>
    </div>

    {% assign all_products = collections.all.products %}
    {% if all_products.size > 0 %}
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {% for product in all_products limit: 9 %}
          <div class="group bg-card rounded-sm border border-border overflow-hidden hover:border-accent/40 hover:shadow-xl transition-all duration-300 animate-on-scroll" style="animation-delay: {{ forloop.index0 | times: 0.1 }}s;">
            <a href="{{ product.url }}" class="block">
              <div class="aspect-[4/3] overflow-hidden" style="background: hsl(var(--secondary) / 0.2);">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                {% else %}
                  <div class="w-full h-full flex items-center justify-center">
                    <p class="text-muted-foreground text-sm font-body">No image</p>
                  </div>
                {% endif %}
              </div>
              <div class="p-6">
                <h3 class="font-display text-xl mb-1">{{ product.title }}</h3>
                <p class="text-accent font-body font-semibold mb-3">
                  {{ product.price | money_without_trailing_zeros }}
                </p>
                <p class="text-muted-foreground text-sm leading-relaxed font-body line-clamp-2 mb-4">{{ product.description | strip_html | truncate: 120 }}</p>
                <span class="inline-flex items-center gap-1.5 text-accent text-sm font-body font-medium">
                  <span data-i18n="products.viewProduct">Learn More</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                </span>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-center text-muted-foreground text-lg font-body animate-on-scroll" data-i18n="products.empty">Our product line is expanding. Explore Beautican — our flagship collagen supplement.</p>
    {% endif %}
  </div>
</section>

