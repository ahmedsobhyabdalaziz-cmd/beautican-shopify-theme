{% render 'header' %}

<!-- ==================== CART DRAWER ==================== -->
<div data-cart-overlay class="sheet-overlay hidden"></div>
<div data-cart-drawer class="sheet-content sheet-right">
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between p-6 border-b border-border">
      <h2 class="text-xl font-display font-semibold">{{ 'cart.title' | t }}</h2>
      <button data-cart-close class="text-muted-foreground hover:text-foreground transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <div data-cart-content class="flex-1 flex flex-col overflow-hidden">
      <div class="flex flex-col items-center justify-center py-16 px-6 text-center">
        <svg class="w-16 h-16 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        <p class="text-muted-foreground">{{ 'cart.empty' | t }}</p>
      </div>
    </div>
  </div>
</div>

<!-- ==================== HERO SECTION ==================== -->
<section class="py-12 md:py-20" style="background: hsl(var(--background));">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
      <!-- Left: Headline & CTAs -->
      <div class="order-2 md:order-1">
        <p class="text-accent font-body text-sm tracking-normal mb-4 animate-on-scroll">{{ 'homepage.hero.tagline' | t }}</p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display tracking-normal mb-6 text-foreground animate-on-scroll">
          <span>{{ 'homepage.hero.title_start' | t }}</span><br />
          <em class="text-accent not-italic">{{ 'homepage.hero.title_accent' | t }}</em>
        </h1>
        <p class="text-base md:text-lg text-muted-foreground leading-snug mb-8 max-w-lg animate-on-scroll">{{ 'homepage.hero.description' | t }}</p>
        <div class="flex flex-col sm:flex-row gap-4 animate-on-scroll">
          <a href="#products" class="inline-flex items-center justify-center px-10 py-5 bg-accent text-accent-foreground font-body font-bold text-sm tracking-normal rounded-sm shadow-md hover:brightness-110 hover:shadow-lg active:scale-[0.97] transition-all">{{ 'homepage.hero.cta' | t }}</a>
          <a href="#about" class="inline-flex items-center justify-center px-10 py-5 border-2 border-primary bg-primary text-primary-foreground font-body font-semibold text-sm tracking-normal rounded-sm hover:bg-transparent hover:text-primary active:scale-[0.97] transition-all">{{ 'homepage.hero.cta_secondary' | t }}</a>
        </div>
      </div>

      <!-- Right: TA Pharma Infographic - logo centre, points around it -->
      <div class="order-1 md:order-2 flex items-center justify-center">
        <!-- Desktop: absolute positioned points around logo -->
        <div class="relative w-full max-w-md mx-auto hidden md:block" style="min-height: 420px;">
          <div class="absolute inset-0 flex items-center justify-center">
            <img src="{{ 'tapharma-logo.png' | asset_url }}" alt="TA Pharma" class="w-44 lg:w-52 object-contain drop-shadow-sm animate-on-scroll" loading="eager" />
          </div>
          <div class="absolute top-0 left-0 max-w-[160px] animate-on-scroll">
            <span class="text-4xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">01</span>
            <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-4px]">{{ 'homepage.philosophy.item_0' | t }}</h3>
          </div>
          <div class="absolute bottom-8 left-0 max-w-[160px] animate-on-scroll">
            <span class="text-4xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">02</span>
            <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-4px]">{{ 'homepage.philosophy.item_1' | t }}</h3>
          </div>
          <div class="absolute top-0 right-0 max-w-[160px] text-right animate-on-scroll">
            <span class="text-4xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">03</span>
            <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-4px]">{{ 'homepage.philosophy.item_2' | t }}</h3>
          </div>
          <div class="absolute bottom-8 right-0 max-w-[160px] text-right animate-on-scroll">
            <span class="text-4xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">04</span>
            <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-4px]">{{ 'homepage.philosophy.item_3' | t }}</h3>
          </div>
        </div>
        <!-- Mobile: logo then 2x2 grid -->
        <div class="md:hidden w-full">
          <div class="flex items-center justify-center mb-8">
            <img src="{{ 'tapharma-logo.png' | asset_url }}" alt="TA Pharma" class="w-36 object-contain animate-on-scroll" loading="eager" />
          </div>
          <div class="grid grid-cols-2 gap-6 px-2">
            <div class="animate-on-scroll">
              <span class="text-3xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">01</span>
              <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-2px]">{{ 'homepage.philosophy.item_0' | t }}</h3>
            </div>
            <div class="animate-on-scroll text-right">
              <span class="text-3xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">02</span>
              <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-2px]">{{ 'homepage.philosophy.item_1' | t }}</h3>
            </div>
            <div class="animate-on-scroll">
              <span class="text-3xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">03</span>
              <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-2px]">{{ 'homepage.philosophy.item_2' | t }}</h3>
            </div>
            <div class="animate-on-scroll text-right">
              <span class="text-3xl font-display font-bold" style="color: hsl(var(--accent) / 0.15);">04</span>
              <h3 class="font-display text-sm font-semibold text-foreground leading-tight mt-[-2px]">{{ 'homepage.philosophy.item_3' | t }}</h3>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==================== PRODUCTS SECTION ==================== -->
<section id="products" class="py-16 md:py-24" style="background: hsl(var(--card));">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto text-center mb-14">
      <span class="inline-block px-5 py-2.5 rounded-full border-2 border-accent bg-accent/10 text-accent font-body text-base md:text-lg font-bold tracking-normal mb-4 animate-on-scroll">{{ 'homepage.products.tagline' | t }}</span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-normal animate-on-scroll">
        <span>{{ 'homepage.products.title' | t }}</span><br />
        <em class="text-accent not-italic">{{ 'homepage.products.title_accent' | t }}</em>
      </h2>
    </div>

    {% assign all_products = collections.all.products %}
    {% if all_products.size > 0 %}
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {% for product in all_products limit: 9 %}
          <div class="group bg-background rounded-sm border border-border overflow-hidden hover:border-accent/40 hover:shadow-xl transition-all duration-300 animate-on-scroll" style="animation-delay: {{ forloop.index0 | times: 0.1 }}s;">
            <!-- Clickable area: image + info — navigates to product page -->
            <a href="{{ product.url }}" class="block">
              <div class="aspect-[4/3] overflow-hidden" style="background: hsl(var(--secondary) / 0.2);">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                {% else %}
                  <div class="w-full h-full flex items-center justify-center">
                    <p class="text-muted-foreground text-sm font-body">No image</p>
                  </div>
                {% endif %}
              </div>
              <div class="px-6 pt-6 pb-4">
                <h3 class="font-display text-base md:text-lg font-bold mb-1 leading-snug">{{ product.title }}</h3>
                <p class="text-accent font-body font-semibold mb-3">
                  {% assign prod_price_num = product.price | divided_by: 100 %}{{ prod_price_num }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="SAR" class="sar-icon" />
                </p>
                {% if product.metafields.custom.positioning %}
                  {% assign pos_data = product.metafields.custom.positioning.value | parse_json %}
                  <p class="text-muted-foreground text-sm leading-snug font-body line-clamp-2">{% if request.locale.iso_code == 'ar' and pos_data.ar != blank %}{{ pos_data.ar }}{% else %}{{ pos_data.en }}{% endif %}</p>
                {% else %}
                  <p class="text-muted-foreground text-sm leading-snug font-body line-clamp-2">{{ product.description | strip_html | truncate: 120 }}</p>
                {% endif %}
              </div>
            </a>
            <div class="px-6 pb-6">
              <a href="{{ product.url }}" class="inline-flex items-center justify-center gap-2 w-full px-5 py-3 bg-accent text-accent-foreground text-sm font-body font-bold rounded-sm shadow-sm hover:brightness-110 hover:shadow-md transition-all">
                <span>{{ 'homepage.products.order_now' | t }}</span>
                <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1 rtl:rotate-180 rtl:group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-center text-muted-foreground text-lg font-body animate-on-scroll">{{ 'homepage.products.empty' | t }}</p>
    {% endif %}
  </div>
</section>

