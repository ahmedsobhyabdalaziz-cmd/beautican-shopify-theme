    <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- Pain Questions -->
      <div class="order-1">
        <div class="space-y-3 mb-8">
          <!-- Joint pain -->
          <div class="v2-pain-card animate-on-scroll">
            <div class="v2-pain-icon" style="background: hsl(var(--destructive) / 0.08);">
              <svg class="w-6 h-6" style="color: hsl(var(--destructive) / 0.7);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" /></svg>
            </div>
            <p class="text-base md:text-lg text-foreground font-medium leading-snug">هل بدأت تشعر بألم في المفاصل؟</p>
          </div>
          <!-- Movement -->
          <div class="v2-pain-card animate-on-scroll" style="animation-delay: 0.08s;">
            <div class="v2-pain-icon" style="background: hsl(var(--accent) / 0.08);">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
            </div>
            <p class="text-base md:text-lg text-foreground/80 leading-snug">صعوبة في الحركة أو طقطقة؟</p>
          </div>
          <!-- Hair / Nails -->
          <div class="v2-pain-card animate-on-scroll" style="animation-delay: 0.16s;">
            <div class="v2-pain-icon" style="background: hsl(var(--brand-burgundy) / 0.08);">
              <svg class="w-6 h-6" style="color: hsl(var(--brand-burgundy));" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
            </div>
            <p class="text-base md:text-lg text-foreground/80 leading-snug">ضعف في الأظافر وتساقط الشعر؟</p>
          </div>
          <!-- Skin -->
          <div class="v2-pain-card animate-on-scroll" style="animation-delay: 0.24s;">
            <div class="v2-pain-icon" style="background: hsl(var(--brand-warm) / 0.12);">
              <svg class="w-6 h-6" style="color: hsl(var(--brand-warm) / 0.9);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
            </div>
            <p class="text-base md:text-lg text-foreground/80 leading-snug">بشرة مرهقة وزيادة في التجاعيد؟</p>
          </div>
        </div>

        <div class="flex items-center gap-3 mb-8 animate-on-scroll" style="animation-delay: 0.32s;">
          <div class="w-12 h-px bg-accent"></div>
          <p class="text-accent font-bold text-base md:text-lg">دعني أشرح لك الأمر ببساطة 👇</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 animate-on-scroll" style="animation-delay: 0.4s;">
          <a href="#pricing" class="v2-pulse inline-flex items-center justify-center px-10 py-4 bg-accent text-accent-foreground font-body font-bold text-sm rounded-lg shadow-md hover:opacity-90 transition-all">اطلب الآن</a>
          <a href="#explanation" class="inline-flex items-center justify-center px-10 py-4 border-2 border-foreground/20 text-foreground font-body font-semibold text-sm rounded-lg hover:bg-foreground hover:text-background transition-all">اقرأ القصة الكاملة</a>
        </div>
      </div>

      <!-- Product Image with Floating Pills -->
      <div class="order-2 flex items-center justify-center">
        <div class="relative w-full max-w-md mx-auto">
          <img
            src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/jj.png?v=1771305698"
            alt="Beautican مكمل الكولاجين المتميز"
            class="w-64 md:w-80 mx-auto drop-shadow-2xl animate-on-scroll"
            loading="eager"
            style="filter: drop-shadow(0 24px 48px rgba(0,0,0,0.12));"
          />
          <!-- Floating benefit pills (desktop only) -->
          <div class="hidden md:flex v2-benefit-pill animate-on-scroll" style="top: 8%; left: -8%; animation-delay: 0.3s;">
            <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            سهل الامتصاص
          </div>
          <div class="hidden md:flex v2-benefit-pill animate-on-scroll" style="top: 35%; right: -12%; animation-delay: 0.45s;">
            <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            فيتامين سي مدمج
          </div>
          <div class="hidden md:flex v2-benefit-pill animate-on-scroll" style="bottom: 20%; left: -5%; animation-delay: 0.6s;">
            <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            نكهة فراولة 🍓
          </div>
          <div class="hidden md:flex v2-benefit-pill animate-on-scroll" style="bottom: 5%; right: -8%; animation-delay: 0.75s;">
            <span class="text-sm">🇮🇹</span>
            تصنيع إيطالي
          </div>
        </div>
      </div>

    </div>

    <!-- Scroll hint -->
    <div class="flex justify-center mt-8 md:mt-12 v2-scroll-hint">
      <svg class="w-6 h-6 text-muted-foreground/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </div>
  </div>
</section>

<!-- Visual connector -->
<div class="v2-connector"></div>

<!-- ==================== CH.1 — EXPLANATION ==================== -->
<section id="explanation" class="relative py-16 md:py-24" style="background-color: hsl(var(--card));">
  <div class="v2-chapter-num">01</div>
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto">

      <div class="text-center mb-12">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-accent/10 text-accent mb-6 animate-on-scroll">فهم المشكلة</span>
        <h2 class="text-3xl md:text-4xl font-display leading-tight animate-on-scroll">ما الذي يحدث في جسمك؟</h2>
      </div>

      <!-- Key message card -->
      <div class="p-8 md:p-10 rounded-2xl border border-border bg-background mb-10 animate-on-scroll">
        <p class="text-foreground text-lg md:text-xl leading-relaxed text-center">
          جسمك بطبيعته قادر على إعادة ترميم نفسه، ومن أهم عناصر البناء في هذه العملية هو <strong class="text-accent">الكولاجين</strong>.
        </p>
      </div>

      <!-- Collagen Decline Visual -->
      <div class="p-8 md:p-10 rounded-2xl border animate-on-scroll" style="background: hsl(var(--destructive) / 0.03); border-color: hsl(var(--destructive) / 0.12);">
        <div class="flex items-center gap-3 mb-6">
          <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center" style="background: hsl(var(--destructive) / 0.1);">
            <svg class="w-5 h-5" style="color: hsl(var(--destructive) / 0.7);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6L9 12.75l4.286-4.286a11.948 11.948 0 014.306 6.43l.776 2.898m0 0l3.182-5.511m-3.182 5.51l-5.511-3.181" /></svg>
          </div>
          <p class="text-foreground text-lg font-bold">بعد سن الـ ٢٥ يبدأ الكولاجين بالانخفاض تدريجيًا</p>
        </div>

        <!-- Visual bar chart -->
        <div class="space-y-4 mb-8">
          <div class="flex items-center gap-4">
            <span class="text-sm font-bold text-foreground w-14 text-left" dir="ltr">20 سنة</span>
            <div class="flex-1 v2-decline-bar-track">
              <div class="v2-decline-bar" style="width: 100%; background: hsl(var(--accent));"></div>
            </div>
            <span class="text-xs font-bold text-accent w-12 text-right">100%</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-sm font-bold text-foreground w-14 text-left" dir="ltr">30 سنة</span>
            <div class="flex-1 v2-decline-bar-track">
              <div class="v2-decline-bar" style="width: 75%; background: hsl(var(--brand-warm));"></div>
            </div>
            <span class="text-xs font-bold w-12 text-right" style="color: hsl(var(--brand-warm));">75%</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-sm font-bold text-foreground w-14 text-left" dir="ltr">40 سنة</span>
            <div class="flex-1 v2-decline-bar-track">
              <div class="v2-decline-bar" style="width: 50%; background: hsl(var(--destructive) / 0.6);"></div>
            </div>
            <span class="text-xs font-bold w-12 text-right" style="color: hsl(var(--destructive) / 0.7);">50%</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-sm font-bold text-foreground w-14 text-left" dir="ltr">50 سنة</span>
            <div class="flex-1 v2-decline-bar-track">
              <div class="v2-decline-bar" style="width: 25%; background: hsl(var(--destructive));"></div>
            </div>
            <span class="text-xs font-bold w-12 text-right" style="color: hsl(var(--destructive));">25%</span>
          </div>
        </div>

        <p class="text-foreground/70 text-sm leading-relaxed text-center">
          ومع نمط الحياة الحالي، والضغوط المستمرة، والتغذية غير المتوازنة — أصبح هذا النقص يظهر بشكل <strong class="text-foreground">أسرع وأكثر وضوحًا</strong>.
        </p>
      </div>

      <!-- Insight callout -->
      <div class="text-center mt-10 animate-on-scroll">
        <div class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl border-2 border-accent/30" style="background: hsl(var(--accent) / 0.06);">
          <span class="text-2xl">💡</span>
          <p class="text-accent font-bold text-base md:text-lg">هنا تظهر الحاجة إلى دعم الجسم بالكولاجين من مصدر خارجي</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Visual connector -->
<div class="v2-connector"></div>

<!-- ==================== CH.2 — MARKET PROBLEM ==================== -->
<section class="relative py-16 md:py-24 bg-background">
  <div class="v2-chapter-num">02</div>
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto">

      <div class="text-center mb-12">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium mb-6 animate-on-scroll" style="background: hsl(var(--destructive) / 0.08); color: hsl(var(--destructive) / 0.8);">المشكلة في السوق</span>
