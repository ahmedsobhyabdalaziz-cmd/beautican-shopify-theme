<!-- ==================== PRICING SECTION ==================== -->
{% unless product %}
  {% assign product = all_products['beautican'] %}
{% endunless %}
<section id="pricing" class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-accent/10 text-accent mb-6 animate-on-scroll">اختر كورسك</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display leading-tight mb-4 animate-on-scroll">
        ابدأ رحلتك مع <span class="text-accent">Beautican</span>
      </h2>
      <p class="text-muted-foreground text-lg animate-on-scroll">
        معظم العملاء يختارون كورس ٢–٣ أشهر للحصول على أفضل النتائج
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto items-stretch">
      {% assign tier_names_ar = "المبتدئ,الأكثر شعبية,التحول الكامل" | split: "," %}
      {% assign tier_subtitles_ar = "كورس شهر واحد,كورس شهرين,كورس ٣ أشهر" | split: "," %}
      {% assign tier_badges_ar = ",أفضل قيمة,أكبر توفير" | split: "," %}
      {% assign tier_desc_ar = "مثالي لتجربة المنتج لأول مرة,الخيار الأكثر شعبية لنتائج ملموسة,للحصول على أقصى النتائج والتوفير" | split: "," %}

      {% for variant in product.variants limit: 3 %}
        {% assign tier_index = forloop.index0 %}
        {% if tier_index == 1 %}
          {% assign is_featured = true %}
        {% else %}
          {% assign is_featured = false %}
        {% endif %}
        {% assign variant_price_num = variant.price | divided_by: 100 %}
        {% assign sachets = 30 %}
        {% if tier_index == 1 %}{% assign sachets = 60 %}{% endif %}
        {% if tier_index == 2 %}{% assign sachets = 90 %}{% endif %}
        {% assign per_sachet = variant.price | divided_by: sachets | divided_by: 100.0 %}

        <div class="relative rounded-2xl border-2 p-8 flex flex-col transition-all animate-on-scroll {% if is_featured %}border-accent{% else %}border-border bg-background hover:shadow-md{% endif %}" style="animation-delay: {{ tier_index | times: 0.1 }}s;{% if is_featured %} background: hsl(var(--accent) / 0.04); box-shadow: 0 20px 40px -10px hsl(var(--accent) / 0.15), 0 0 0 1px hsl(var(--accent) / 0.2);{% endif %}">

          {% if tier_badges_ar[tier_index] != "" %}
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="inline-flex items-center gap-1.5 px-4 py-1 bg-accent text-accent-foreground text-xs font-body font-semibold tracking-normal rounded-full">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                {{ tier_badges_ar[tier_index] }}
              </span>
            </div>
          {% endif %}

          <div class="text-center mb-6">
            <p class="text-sm font-body tracking-normal text-muted-foreground mb-1">{{ tier_names_ar[tier_index] }}</p>
            <p class="font-display text-lg">{{ tier_subtitles_ar[tier_index] }}</p>
            <p class="text-xs text-muted-foreground mt-1">{{ sachets }} كيس</p>
          </div>

          <div class="text-center mb-4">
            <p class="text-4xl font-display">
              {{ variant_price_num }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="ر.س" class="sar-icon sar-icon-lg" />
            </p>
            <p class="text-sm text-muted-foreground mt-1">
              {{ per_sachet | round: 2 }} <img src="https://cdn.shopify.com/s/files/1/0805/3463/4755/files/sar.png?v=1771305908" alt="ر.س" class="sar-icon sar-icon-sm" /> لكل كيس
            </p>
            {% if tier_index > 0 %}
              {% assign base_price_cents = 28500 %}
              {% assign base_total_cents = base_price_cents | times: sachets | divided_by: 30 %}
              {% assign savings = base_total_cents | minus: variant.price | times: 100 | divided_by: base_total_cents %}
              <p class="text-sm text-accent font-bold mt-2">وفّر {{ savings }}%</p>
            {% endif %}
          </div>

          <!-- Tier description -->
          <p class="text-center text-sm text-muted-foreground mb-6 flex-1">{{ tier_desc_ar[tier_index] }}</p>

          <button
            data-add-to-cart
            data-variant-id="{{ variant.id }}"
            data-quantity="1"
            class="w-full font-body font-bold text-sm tracking-normal rounded-xl transition-all disabled:opacity-50 flex items-center justify-center gap-3 hover:brightness-110 hover:shadow-lg active:scale-[0.98] {% if is_featured %}bg-accent text-accent-foreground v2-pulse{% else %}bg-primary text-primary-foreground{% endif %}"
            style="min-height: 56px; padding: 16px 24px; {% if is_featured %}box-shadow: 0 4px 14px hsl(var(--accent) / 0.3);{% endif %}"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            {% if is_featured %}احصل على أفضل عرض{% else %}أضف إلى السلة{% endif %}
          </button>
        </div>
      {% endfor %}
    </div>

    <p class="text-center text-sm text-muted-foreground mt-10 animate-on-scroll">
      شحن مجاني على جميع الحزم · ضمان رضا لمدة 30 يوم
    </p>
  </div>

  <!-- Sticky mobile bottom bar -->
  <div class="fixed bottom-0 left-0 right-0 z-40 md:hidden border-t border-border p-3" style="background: hsl(var(--background) / 0.97); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
    <a
      href="#pricing"
      class="w-full font-body font-bold text-sm tracking-normal rounded-xl bg-accent text-accent-foreground flex items-center justify-center gap-3 hover:brightness-110 active:scale-[0.98] transition-all"
      style="min-height: 52px; padding: 14px 24px; box-shadow: 0 4px 14px hsl(var(--accent) / 0.3); text-decoration: none;"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
      </svg>
      احصل على أفضل عرض
    </a>
  </div>
</section>

<!-- ==================== FINAL CTA ==================== -->
<section class="py-16 md:py-24" style="background-color: hsl(var(--card));">
  <div class="container mx-auto px-6 lg:px-16">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-display leading-tight mb-6 animate-on-scroll">
